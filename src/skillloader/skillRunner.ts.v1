// skillRunner.ts
import OpenAI from 'openai';
import type { Skill } from './skillLoader.ts';

export interface SkillRunOptions {
    model: string;
    temperature?: number;

    /** 共享参考（例如 rubric 的 body），会作为独立段落拼进 system */
    sharedContext?: string;

    /** 追加在 user message 末尾，用于附加"这是本次要分析的数据"等 */
    appendix?: string;

    /** 是否要求结构化 JSON 输出 */
    outputMode?: 'markdown' | 'json';

    /** 自定义 system 片段（可覆盖或追加） */
    systemSuffix?: string;
}

export interface SkillRunResult<T = string> {
    output: T;
    raw: string;
    usage?: { promptTokens: number; completionTokens: number };
}

function buildSystem(skill: Skill, opts: SkillRunOptions): string {
    const parts: string[] = [];

    parts.push(
        `# 技能：${skill.name}` +
        (skill.description ? `\n${skill.description}` : ''),
    );

    parts.push(`# 技能指令\n${skill.body}`);

    if (opts.sharedContext) {
        parts.push(`# 共享参考：分析量表（必须严格遵守）\n${opts.sharedContext}`);
    }

    if (opts.systemSuffix) {
        parts.push(opts.systemSuffix);
    }

    return parts.join('\n\n---\n\n');
}

